{
  "name": "sage-astra-voice-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-25",
  "vars": {
    "PUBLIC_ORIGIN": "https://jimjamms.github.io",
    "REALTIME_MODEL": "gpt-realtime-2.1",
    "PIPELINE_CHAT_MODEL": "gpt-6-astra"
  },
  "ratelimits": [
    { "name": "DEMO_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ]
}
