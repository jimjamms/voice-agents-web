{
	"name": "sage-astra-voice-api",
	"main": "src/index.mjs",
	"compatibility_date": "2026-09-25",
	"vars": {
		"PUBLIC_ORIGIN": "https://jimjamms.github.io",
		"REALTIME_MODEL": "gpt-realtime-2.1",
		"PIPELINE_CHAT_MODEL": "gpt-6-astra"
	},
	"ratelimits": [
		{
			"name": "DEMO_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 6,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "LOG_DB",
			"database_name": "sage-astra-chat-logs",
			"database_id": "5b8be64a-0708-4cdf-ac49-647cce71c3bf"
		}
	]
}